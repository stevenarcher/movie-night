# PostgreSQL
DATABASE_URL="postgresql://movie:movie@localhost:5432/movie_night?schema=public"

# NextAuth (Auth.js) — generate a secret with: `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth — from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public base URL of the app (used for webhooks & callbacks)
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# WhatsApp Cloud API — from https://developers.facebook.com/apps/ (Meta App)
# Webhook verify token: any random string you define; must match what you enter in Meta's webhook config.
WA_WEBHOOK_VERIFY_TOKEN=""
# Meta App Secret — used to verify X-Hub-Signature-256 on incoming webhooks.
WA_APP_SECRET=""
# Restrict ingestion to a single WhatsApp group id (leave empty to accept any group).
WA_GROUP_ID=""
# Phone number id + system user token — only needed to SEND announcement messages. Optional.
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
# The business phone number (international format, e.g. 15551234567) messages are sent from.
WA_FROM_PHONE=""

# TMDB (The Movie Database) — read access token from https://www.themoviedb.org/settings/api (API Read Access Token v4)
TMDB_READ_TOKEN=""