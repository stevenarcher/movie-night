/// Movie Night — data model
///
/// Candidate (the spin pool) is kept decoupled from Screening (weekly history)
/// so ratings and past choices never affect future wheel outcomes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js Prisma adapter models)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  googleId      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  ratings     Rating[]
  candidates  Candidate[]
  screenings  Screening[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

enum CandidateSource {
  WHATSAPP
  MANUAL
}

/// A movie sitting in the wheel pool for an upcoming week.
/// Deduplication happens via the unique normalizedTitle.
model Candidate {
  id              String          @id @default(cuid())
  title           String
  normalizedTitle String          @unique
  source          CandidateSource @default(MANUAL)
  addedByUserId   String?
  addedBy         User?           @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  senderName      String?
  senderWaid      String?
  messageId       String?         @unique
  groupId         String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  screening Screening?

  @@index([source])
  @@index([addedByUserId])
  @@index([createdAt])
}

/// One week's locked-in movie (the weekly history / archive).
model Screening {
  id               String   @id @default(cuid())
  year             Int
  weekNumber       Int
  weekStart        DateTime
  movieTitle       String
  candidateId      String?  @unique
  candidate        Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  selectedByUserId String?
  selectedBy       User?    @relation(fields: [selectedByUserId], references: [id], onDelete: SetNull)
  votes            Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())

  ratings Rating[]

  @@unique([year, weekNumber])
  @@index([weekNumber])
  @@index([createdAt])
}

/// A 0–5 star rating (in 0.25 increments) of a past Screening, unique per (user, screening).
model Rating {
  id          String   @id @default(cuid())
  userId      String
  screeningId String
  value       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  screening Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@unique([userId, screeningId])
  @@index([screeningId])
}